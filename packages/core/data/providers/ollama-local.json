{
  "id": "ollama-local",
  "name": "Astra Local Ollama (private outbound relay)",
  "type": "openai-compatible",
  "baseUrl": "http://127.0.0.1:3000/_internal/astra-ollama/v1",
  "apiKeyEnv": "ASTRA_LOCAL_OLLAMA_BRIDGE_TOKEN",
  "features": {
    "streaming": true,
    "toolUse": true,
    "vision": false,
    "jsonMode": false,
    "systemMessage": true
  },
  "models": [
    {
      "id": "qwen3:4b-instruct",
      "name": "Qwen3 4B Instruct (local)",
      "contextWindow": 8192,
      "maxOutput": 2048,
      "inputPrice": 0,
      "outputPrice": 0,
      "capabilities": [
        "chat",
        "function_calling",
        "streaming"
      ],
      "default": true
    }
  ],
  "timeout": 48000,
  "maxRetries": 0
}
